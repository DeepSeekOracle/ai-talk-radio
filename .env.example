# .env.example — ungated desk
# Google Cloud Storage bucket name for private share URLs (optional)
GCS_BUCKET_NAME=

# Ungated default is unlimited. Set only if a steward wants a cap.
# DAILY_QUOTA_LIMIT=999999

# Optional cloud path. If unset, generate-show uses VoiceStudio local pipeline.
# GEMINI_API_KEY=

# Local OmniVoice (default)
VOICESTUDIO_URL=http://127.0.0.1:3900

# Hugging Face / Docker uses 7860. Local default in server is 3000.
# PORT=3000

NODE_ENV=development